# ═══════════════ M0 — local infra (Docker, no keys needed) ═══════════════
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=specter-dev-pw
NEO4J_READONLY_USER=specter_ro
NEO4J_READONLY_PASSWORD=specter-ro-pw
REDIS_URL=redis://localhost:6380/0
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces

# ═══════════════ M1 — ingestion ═══════════════
# NPPES: open API, no key
# LEIE: open CSV, no key
# DOJ: public pages, no key
# State Medicaid exclusion lists (FL/TX/CA): public downloads, no key

# ═══════════════ M3+ — Azure OpenAI (GPT family) ═══════════════
AZURE_API_KEY=
AZURE_API_BASE=https://<your-resource>.openai.azure.com/
AZURE_API_VERSION=2025-04-01-preview
AZURE_DEPLOYMENT_NANO=gpt-5.4-nano
AZURE_DEPLOYMENT_MINI=gpt-5.4-mini
AZURE_DEPLOYMENT_MAIN=gpt-5.4
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# ═══════════════ M5+ — Vertex (grounding only) ═══════════════
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=./.secrets/vertex-sa.json
VERTEX_GROUNDING_MODEL=gemini-3.7-flash

# ═══════════════ M11 — Google Maps Platform (address classification) ═══════════════
# CLAUDE.md Amendment 4(c). This is an API KEY, not an IAM role on the Vertex
# service account above — Maps Platform does not authenticate with the SA, and
# there is no "Maps role" to grant. Create it under APIs & Services ->
# Credentials, enable the Address Validation API on the project, and restrict
# the key to that API plus an IP restriction.
# Optional: every non-M11 script runs fine without it.
GOOGLE_MAPS_API_KEY=

# ═══════════════ Run control ═══════════════
SPECTER_RUN_PROFILE=default      # default | cost | quality
SPECTER_CACHE_ENABLED=true
SPECTER_MAX_COHORT=250
SPECTER_JUDGE_SAMPLE_COUNT=3     # rubric judge samples per case at T2 (CLAUDE.md Amendment 2); use 1 for dev runs
COHORT_TAXONOMY_PREFIX=332
COHORT_STATES=FL,TX,CA
