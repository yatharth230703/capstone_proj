.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.context/

# plan §5.3: raw downloads are immutable and gitignored; only the frozen
# snapshot (data/snapshot/) and generated synthetic scenarios are committed
data/raw/

# run artifacts, not source: the cost ledger and stored evidence artifacts are
# regenerated by each run
data/ledger.sqlite
data/evidence/
data/cases/
# M12: the persisted IsolationForest + sidecar. Gitignored, not committed,
# for the same reason data/evidence/ is: its sidecar cites an artifact_id in
# data/evidence/, so committing one without the other leaves an unresolvable
# citation on a fresh checkout. Regenerate both together with
# `python scripts/70_train_anomaly_model.py` (~19 min on the full cohort,
# measured live 2026-08-18).
data/models/
.secrets/

# Playwright MCP's own run artifacts (screenshots, console logs) — written
# to the cwd by @playwright/mcp, not source.
.playwright-mcp/
